            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/api/v1/auth/logout",
              "host": ["{{auth_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Invalidates the JWT access token into Redis Blacklist."
          }
