      "name": "1. Authentication (Login / Register / Refresh / Logout)",
      "item": [
        {
          "name": "1.1. Login as Admin (ROLE_ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    var data = res.data || res;",
                  "    if (data.accessToken) {",
                  "        pm.collectionVariables.set('jwt_token', data.accessToken);",
                  "        console.log('Admin JWT Token saved:', data.accessToken);",
                  "    }",
                  "    if (data.refreshToken) {",
                  "        pm.collectionVariables.set('refresh_token', data.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"Test123456@\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/v1/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Logs in as System Administrator with seeded password Test123456@ and saves JWT token."
          }
        },
