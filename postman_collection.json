                  "key": "status",
                  "value": "PENDING"
                }
              ]
            },
            "description": "Queries pending or in-progress pickup dispatch missions."
          }
        },
        {
          "name": "3.5. Dispatch Pickup Task to Driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
