  "item": [
    {
      "name": "1. Authentication & IAM Service (:8080 or Gateway :8000)",
      "item": [
        {
          "name": "1.1. Login as Admin (Obtain JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    var data = res.data || res;",
                  "    if (data.accessToken) {",
                  "        pm.collectionVariables.set('jwt_token', data.accessToken);",
                  "        console.log('JWT Token saved:', data.accessToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates user via Keycloak OIDC / Local DB and returns JWT access & refresh token."
          }
        },
        {
          "name": "1.2. Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"linh_customer\",\n  \"email\": \"linh.logistics@example.com\",\n  \"password\": \"linh123456\",\n  \"fullName\": \"Nguyễn Văn Linh\",\n  \"phone\": \"0988123456\",\n  \"role\": \"ROLE_CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Registers a new customer, courier driver or merchant account."
          }
        },
        {
          "name": "1.3. Get Current User Context (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
