    {
      "name": "2. Order Management Service (:8081 or Gateway :8000)",
      "item": [
        {
          "name": "2.1. Calculate Shipping Price Estimate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weightKg\": 3.5,\n  \"distanceKm\": 45.0,\n  \"declaredValue\": 2500000,\n  \"codAmount\": 500000,\n  \"expressDelivery\": true\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders/calculate-price",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "orders", "calculate-price"]
            },
            "description": "Calculates shipping fee breakdown based on distance, weight, insurance fee, and COD."
          }
        },
        {
          "name": "2.2. Create Shipment Order (Outbox & Kafka)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.trackingNumber) {",
                  "        pm.collectionVariables.set('sample_tracking_number', data.trackingNumber);",
                  "        console.log('Saved tracking number:', data.trackingNumber);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{sample_customer_id}}\",\n  \"senderName\": \"Tổng Kho Cầu Giấy\",\n  \"senderPhone\": \"0988776655\",\n  \"senderAddress\": \"120 Xuân Thủy, Cầu Giấy, Hà Nội\",\n  \"senderLatitude\": 21.0366,\n  \"senderLongitude\": 105.7828,\n  \"recipientName\": \"Nguyễn Thị Mai\",\n  \"recipientPhone\": \"0912345678\",\n  \"recipientAddress\": \"45 Nguyễn Văn Linh, Hải Châu, Đà Nẵng\",\n  \"recipientLatitude\": 16.0611,\n  \"recipientLongitude\": 108.2198,\n  \"totalWeightKg\": 2.8,\n  \"totalVolumeM3\": 0.015,\n  \"declaredValue\": 1500000,\n  \"codAmount\": 350000,\n  \"specialInstructions\": \"Hàng điện tử dễ vỡ, giao giờ hành chính\",\n  \"items\": [\n    {\n      \"itemName\": \"Bàn phím cơ không dây\",\n      \"quantity\": 1,\n      \"weightKg\": 1.2,\n      \"declaredValue\": 1000000,\n      \"category\": \"ELECTRONICS\"\n    },\n    {\n      \"itemName\": \"Chuột Gaming Ergonomic\",\n      \"quantity\": 1,\n      \"weightKg\": 0.4,\n      \"declaredValue\": 500000,\n      \"category\": \"ELECTRONICS\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Creates shipment order with Transactional Outbox pattern and dispatches order-created Kafka event."
          }
        },
        {
          "name": "2.3. Track Order By Tracking Number",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders/track/{{sample_tracking_number}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "orders", "track", "{{sample_tracking_number}}"]
            },
            "description": "Retrieves comprehensive shipment details by tracking number."
          }
        },
        {
          "name": "2.4. List Orders by Customer ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/orders/customer/{{sample_customer_id}}?page=0&size=10",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "orders", "customer", "{{sample_customer_id}}"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Returns paginated list of shipment orders created by a specific customer."
