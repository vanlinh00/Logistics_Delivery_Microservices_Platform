          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/fleet/find-nearest-driver?lat=21.0366&lon=105.7828&vehicleType=MOTORBIKE",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "fleet", "find-nearest-driver"],
              "query": [
