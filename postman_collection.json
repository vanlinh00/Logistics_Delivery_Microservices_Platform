            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\",\n  \"reason\": \"Package departed origin hub for linehaul delivery\",\n  \"assignedDriverId\": \"{{sample_driver_id}}\",\n  \"currentHubId\": \"HUB-HANOI-01\",\n  \"note\": \"Dispatched on Truck Linehaul-NorthSouth-02\"\n}"
