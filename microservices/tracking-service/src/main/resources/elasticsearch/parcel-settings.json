{
  "index": {
    "number_of_shards": 2,
    "number_of_replicas": 1,
    "max_ngram_diff": 15,
    "analysis": {
      "filter": {
        "autocomplete_filter": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_ngram": 15
        },
        "vietnamese_ascii_folding": {
          "type": "asciifolding",
          "preserve_original": true
        }
      },
      "analyzer": {
        "autocomplete_index": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "vietnamese_ascii_folding",
            "autocomplete_filter"
          ]
        },
        "autocomplete_search": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "vietnamese_ascii_folding"
          ]
        },
        "vietnamese_standard_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "vietnamese_ascii_folding"
          ]
        }
      }
    }
  }
}
