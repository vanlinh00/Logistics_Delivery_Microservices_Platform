{
  "info": {
    "_postman_id": "notification-service-postman-collection-v1",
    "name": "Notification & Multi-Channel Alert Service (Port 8085)",
    "description": "Comprehensive Postman Collection for urgent parcel notifications, multi-channel concurrent broadcasting (Email, SMS, Zalo ZNS, Push FCM), delivery audit logs, and Kafka event dispatching.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "notification_service_url",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "gateway_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sample_tracking_number",
      "value": "VN-EXP-2026-984210",
      "type": "string"
    },
    {
      "key": "sample_recipient_phone",
      "value": "+1-555-0199",
      "type": "string"
    },
    {
      "key": "sample_recipient_email",
      "value": "recipient@example.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Notification Dispatching",
      "item": [
        {
          "name": "1.1. Send Manual Alert via Single Channel (SMS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{sample_recipient_phone}}\",\n  \"channel\": \"SMS\",\n  \"title\": \"Package Out for Delivery\",\n  \"content\": \"Shipment {{sample_tracking_number}} is arriving today with your assigned courier. Expected delivery between 2:00 PM and 4:00 PM.\",\n  \"trackingNumber\": \"{{sample_tracking_number}}\"\n}"
            },
            "url": {
              "raw": "{{notification_service_url}}/api/v1/notifications/send-manual",
              "host": ["{{notification_service_url}}"],
              "path": ["api", "v1", "notifications", "send-manual"]
            },
            "description": "Dispatches SMS notification using Strategy & Factory patterns and saves audit record."
          }
        },
        {
          "name": "1.2. Send Manual Alert via Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{sample_recipient_email}}\",\n  \"channel\": \"EMAIL\",\n  \"title\": \"Delivery Confirmation for Shipment {{sample_tracking_number}}\",\n  \"content\": \"Your package has been successfully delivered and signed. Thank you for choosing our logistics services!\",\n  \"trackingNumber\": \"{{sample_tracking_number}}\"\n}"
            },
            "url": {
              "raw": "{{notification_service_url}}/api/v1/notifications/send-manual",
              "host": ["{{notification_service_url}}"],
              "path": ["api", "v1", "notifications", "send-manual"]
            },
            "description": "Dispatches Email notification via SMTP strategy."
          }
        },
        {
          "name": "1.3. Multi-Threaded Concurrent Broadcast (All Channels)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channels\": [\"EMAIL\", \"SMS\", \"ZALO_ZNS\", \"PUSH\"],\n  \"recipient\": \"{{sample_recipient_phone}}\",\n  \"title\": \"Urgent Shipment Status Alert\",\n  \"content\": \"Urgent update regarding package {{sample_tracking_number}}: Carrier has arrived at your destination address.\",\n  \"trackingNumber\": \"{{sample_tracking_number}}\"\n}"
            },
            "url": {
              "raw": "{{notification_service_url}}/api/v1/notifications/broadcast-parallel",
              "host": ["{{notification_service_url}}"],
              "path": ["api", "v1", "notifications", "broadcast-parallel"]
            },
            "description": "Broadcasts notifications across multiple worker threads concurrently using CompletableFuture."
          }
        }
      ]
    },
    {
      "name": "2. Delivery Logs & Auditing",
      "item": [
        {
          "name": "2.1. List All Notification Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{notification_service_url}}/api/v1/notifications/logs",
              "host": ["{{notification_service_url}}"],
              "path": ["api", "v1", "notifications", "logs"]
            },
            "description": "Lists all persisted notification delivery audit logs."
          }
        },
        {
          "name": "2.2. Query Notification Logs by Recipient",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{notification_service_url}}/api/v1/notifications/logs?recipient={{sample_recipient_phone}}",
              "host": ["{{notification_service_url}}"],
              "path": ["api", "v1", "notifications", "logs"],
              "query": [
                {
                  "key": "recipient",
                  "value": "{{sample_recipient_phone}}"
                }
              ]
            },
            "description": "Filters notification history for a specific recipient."
          }
        },
        {
          "name": "2.3. Query Notification Logs by Tracking Number",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{notification_service_url}}/api/v1/notifications/logs?trackingNumber={{sample_tracking_number}}",
              "host": ["{{notification_service_url}}"],
              "path": ["api", "v1", "notifications", "logs"],
              "query": [
                {
                  "key": "trackingNumber",
                  "value": "{{sample_tracking_number}}"
                }
              ]
            },
            "description": "Filters notification history for a specific shipment tracking number."
          }
        }
      ]
    },
    {
      "name": "3. Actuator & Monitoring",
      "item": [
        {
          "name": "3.1. Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{notification_service_url}}/actuator/health",
              "host": ["{{notification_service_url}}"],
              "path": ["actuator", "health"]
            },
            "description": "Checks status of database, Redis, and Kafka connectors."
          }
        },
        {
          "name": "3.2. Service Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{notification_service_url}}/actuator/info",
              "host": ["{{notification_service_url}}"],
              "path": ["actuator", "info"]
            },
            "description": "Returns Spring Boot application build metadata."
          }
        },
        {
          "name": "3.3. Swagger OpenAPI Docs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{notification_service_url}}/v3/api-docs",
              "host": ["{{notification_service_url}}"],
              "path": ["v3", "api-docs"]
            },
            "description": "OpenAPI specification for Notification Service."
          }
        }
      ]
    }
  ]
}
